# Vercel 会自动注入 KV 相关变量（在 Dashboard 创建 KV 并关联项目后）：
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# 保护定时任务入口：Vercel Cron 会在请求头带上该值（部署文档有说明）
CRON_SECRET=

# 可选：管理页面写操作的口令（不设置则管理接口不鉴权，仅适合内网/开发）
ADMIN_TOKEN=

# 可选：本地开发时默认的企业微信 webhook key（也可在页面"设置"中填写）
WECOM_WEBHOOK_KEY=

# 可选：时区（消息时间显示），默认 Asia/Shanghai
TZ=Asia/Shanghai
