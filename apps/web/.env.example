# Vercel Marketplace 的 Redis（Upstash）集成会自动注入以下变量（无需手动复制）：
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 保护巡检入口：外部定时服务（cron-job.org）用 ?key=<CRON_SECRET> 调用
CRON_SECRET=

# 可选：管理页面写操作的口令（不设置则管理接口不鉴权，仅适合内网/开发）
ADMIN_TOKEN=

# 可选：本地开发时默认的企业微信 webhook key（也可在页面"设置"中填写）
WECOM_WEBHOOK_KEY=

# 注意：Vercel 上请勿设置 TZ（保留变量名，会报错）；消息时间固定按北京时间显示。
# 本地开发时可选：TZ=Asia/Shanghai