# 企业微信机器人 webhook key（也可在管理页"全局设置"中配置）
WECOM_WEBHOOK_KEY=

# 本地运行时如需代理访问 Steam（国内网络），填写如 http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=

# Steam 市场币种，23 = 人民币（默认）
STEAM_CURRENCY=23

# 轮询间隔（秒），本地模式默认 60
POLL_INTERVAL_SEC=60

# 数据文件位置（可选，默认 ./data/db.json）
# DATA_FILE=

# 消息时间显示时区（默认 Asia/Shanghai）
TZ=Asia/Shanghai
